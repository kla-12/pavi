# Pavi Environment Configuration Example Template
# Copy this to .env and fill in your values. Do NOT commit .env to source control!

# Port the backend server will listen on
PORT=3000

# Base URL for the local Ollama instance (or fallback local LLM API)
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# Default model name installed in local Ollama (e.g. phi3:mini, llama3, etc.)
DEFAULT_MODEL=phi3:mini

# Optional: GitHub personal access token (speeds up repository ingestion / avoids rate limits)
GITHUB_TOKEN=

# Secret key used for signing JWT authentication tokens (Must be kept secure!)
JWT_SECRET=generate_a_random_jwt_secret_here

# SQLite Database filepath
SQLITE_DB_PATH=./pavi.db

# Opt-in: Bypasses authentication strictly for localhost connections (127.0.0.1 / ::1)
# WARNING: Bypassing auth is fine for local-only use, but dangerous if other local network devices can access your port.
SKIP_AUTH_ON_LOCALHOST=false

LOG_LEVEL=info

# Phase E: PWA Web Push & Mobile Authentication
VAPID_PUBLIC_KEY=your_generated_vapid_public_key
VAPID_PRIVATE_KEY=your_generated_vapid_private_key
VAPID_EMAIL=admin@pavi.local
MOBILE_PIN=123456

